# Copy to .env for local development. Never commit credentials.
MIXVERSE_DATA_DIR=./data/mixverse
MIXVERSE_TTL_HOURS=24
MIXVERSE_LLM_PROVIDER=rules
MIXVERSE_MUSIC_PROVIDER=none
MIXVERSE_MUSIC_MODEL=music_v2_5
# ANTHROPIC_API_KEY=
# MIXVERSE_LLM_MODEL=
# To enable paid AI music generation (provider settings only on the backend):
# MIXVERSE_MUSIC_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=your_key_here
